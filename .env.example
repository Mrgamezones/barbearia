# Copie para `.env` (Docker: `npm run docker:up`) ou `.env.local` (`npm run dev` no host).
# Os valores abaixo já funcionam com o Supabase local deste projeto (`npx supabase start`).
# Chaves do Supabase local: chaves de demonstração públicas da CLI (`npx supabase status -o env`).
# Nunca use estes valores em produção.

# --- Supabase (host: API exposta pela CLI) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:56321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
# Somente servidor. Nunca exponha no navegador.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
BUSINESS_TIMEZONE=America/Sao_Paulo

# --- Web Push (par de TESTE; em produção gere outro com `npx web-push generate-vapid-keys`) ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BGfXCB5j9BZF0r7-gsfsEyi2_Px5GRX5wFlQ2C2AIF9EbAUYvFa4rCQCyr-N9hysOaSpGtrDRc2AoKXF7n09bFE
VAPID_PRIVATE_KEY=3DQWplhidkdiCKRu2MLdle-qoo4ZHu6-1gWDzhQJQc4
VAPID_SUBJECT=mailto:contato@barbearia.local

# --- E-mail ---
# EMAIL_TRANSPORT=resend (padrão): sem RESEND_API_KEY os e-mails são apenas registrados no log.
RESEND_API_KEY=
EMAIL_FROM=Barbearia <agendamentos@barbearia.local>

# --- WhatsApp (Cloud API da Meta; veja docs/whatsapp-templates.md) ---
# Sem WHATSAPP_TOKEN ou WHATSAPP_PHONE_NUMBER_ID as mensagens são apenas registradas (dry_run).
# Somente servidor. Nunca use prefixo NEXT_PUBLIC_.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_TEMPLATE_LANG=pt_BR

# --- Cron de lembretes (segredo enviado no header Authorization: Bearer) ---
CRON_SECRET=segredo-local-de-teste

# --- Ambiente Docker ---
# O docker-compose.yml já define os valores abaixo para a rede do Supabase local.
# Descomente apenas para sobrescrever. Não defina no `.env.local`: `npm run dev` no host
# usaria endereços que só existem dentro da rede Docker.
# SUPABASE_INTERNAL_URL=http://supabase_kong_barbearia:8000   # Kong do Supabase local (servidor e proxy /supabase)
# EMAIL_TRANSPORT=smtp                                         # e-mails vão para a caixa de teste local
# SMTP_HOST=supabase_inbucket_barbearia                        # Mailpit da CLI (interface: http://localhost:56324)
# SMTP_PORT=1025
# MOBILE_WORKERS=2                                             # navegadores em paralelo na simulação mobile
